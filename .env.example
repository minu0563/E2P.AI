DATABASE_URL="postgresql://prompt_app:prompt_app@localhost:5432/prompt_app"
APP_URL="http://localhost:3000"
# 약관 버전 (바뀌면 재동의 필요)
TERMS_VERSION="2026-11-12"

# 추론 (ollama | openai)
INFERENCE_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_KEEP_ALIVE="30m"
ANALYSIS_MODEL="qwen3-vl:8b-instruct"
GENERATION_MODEL="gemma4:e4b"
# INFERENCE_BASE_URL=""
# INFERENCE_API_KEY=""

# Google 로그인 (Google Cloud 콘솔 > OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 큐·속도 제한 (Redis). 운영에서는 비밀번호 포함: redis://:비밀번호@host:6379
REDIS_URL="redis://localhost:6379"
# 큐 이미지 암호화 키: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEUE_SECRET=""
# 개발용 차단 원인 표시. 운영에서는 넣지 않는다
# SAFETY_DEBUG="1"
# 테스트 계정 이메일(쉼표 구분): 크레딧 차감·속도 제한 없음. 안전 검사 shadow는 운영(NODE_ENV=production)에서는 적용되지 않는다
TEST_ACCOUNTS=""
# 관리자 화면(/admin) 접근 이메일 (쉼표 구분). 비어 있으면 아무도 못 들어간다
ADMIN_EMAILS=""
