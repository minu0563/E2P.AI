DATABASE_URL="postgresql://prompt_app:prompt_app@localhost:5432/prompt_app"
APP_URL="http://localhost:3000"
# 약관 버전 (바뀌면 재동의 필요)
TERMS_VERSION="2026-11-12"

# 추론 (ollama | openai)
INFERENCE_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_KEEP_ALIVE="30m"
# 모델 하나로 분석·분류·작성 (로컬 gemma4:12b, 운영 직전 Workers AI 26B로 교체)
MODEL="gemma4:12b"
# INFERENCE_BASE_URL=""
# INFERENCE_API_KEY=""

# Google 로그인 (Google Cloud 콘솔 > OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 개발용 차단 원인 표시. 운영에서는 넣지 않는다
# SAFETY_DEBUG="1"
# 테스트 계정 이메일(쉼표 구분): 크레딧 차감·속도 제한 없음. 안전 검사 shadow는 운영(NODE_ENV=production)에서는 적용되지 않는다
TEST_ACCOUNTS=""
# 관리자 화면(/admin) 접근 이메일 (쉼표 구분). 비어 있으면 아무도 못 들어간다
ADMIN_EMAILS=""
# 봇 방지(Cloudflare Turnstile). 둘 다 비우면 로컬에서 건너뜀. 아래는 Cloudflare 공개 테스트 키(항상 통과)
# 운영·스테이징: SITE_KEY는 wrangler vars, SECRET은 `wrangler secret put TURNSTILE_SECRET -e staging`
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
