// OpenNext(Cloudflare) 공식 방식: prisma-client-js + output 지정 없음 → OpenNext가 빌드 때 Workers용으로 패치한다
// (출력 경로를 지정하면 패치되지 않아 Workers에서 WebAssembly 실행 중 컴파일 오류가 난다)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  /// Google 계정 고유 ID (OIDC sub). 이메일이 바뀌어도 같은 사람
  googleSub  String?   @unique
  name       String?
  verifiedAt DateTime?
  /// 관리자가 정지한 시각 (있으면 로그인·생성 불가)
  suspendedAt   DateTime?
  suspendReason String?
  createdAt  DateTime  @default(now())
  sessions   Session[]
  consents   Consent[]
  credits    CreditEntry[]
  logs       GenerationLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 약관 동의 시각·버전 기록
model Consent {
  id        String   @id @default(cuid())
  userId    String
  version   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

enum CreditKind {
  grant    // 지급 (+). grantId = 자기 자신
  reserve  // 요청 시작 시 예약 (-)
  release  // 실패·차단 시 예약 반환 (+)
  confirm  // 성공 확정 표시 (0)
  adjust   // 관리자 조정 (+/-)
}

enum CreditType {
  promo
  subscription
  topup
}

/// 크레딧 원장 (추가만 한다. 수정·삭제 금지 — 사람이 직접 검토할 코드).
/// 잔액 = 유효기간이 남은 지급분(grantId)별 amount 합.
model CreditEntry {
  id             String     @id
  userId         String
  kind           CreditKind
  creditType     CreditType
  amount         Int
  /// 어느 지급분에서 나가고 들어왔는지 (지급 항목은 자기 id)
  grantId        String
  requestId      String?
  /// 지급 항목만: 유효기간 (없으면 무기한)
  expiresAt      DateTime?
  /// 같은 이벤트가 두 번 처리되지 않게 (결제 웹훅 중복 등)
  idempotencyKey String?    @unique
  note           String?
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind])
  @@index([grantId])
  @@index([requestId])
}

/// 요청 로그 (텍스트·메타데이터만, 이미지 원본 저장 금지)
model GenerationLog {
  id          String   @id @default(cuid())
  requestId   String   @unique
  userId      String
  mode        String
  profile     String
  requestText String
  outcome     String
  blockCode   String?
  creditCost  Int
  /// 생성된 프롬프트 (성공한 경우). 다시 불러와 고칠 수 있게
  prompt      String?
  /// 당시 입력값: 모드, 항목별 값, 진행 속도, 길이, 비율, 빈칸 모드 (이미지는 저장하지 않음)
  input       Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 관리자 작업 기록 (누가 언제 무엇을). 추가만 한다
model AdminLog {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetUserId String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

/// 고정 창 속도 제한 카운터 (key = 대상:창번호). 만료된 줄은 정리 작업이 지운다
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// 진행 중인 생성 (사용자당 한 줄 → 동시 1건). 요청이 끝나면 지우고, 남으면 만료 후 다시 잡을 수 있다
model ActiveGeneration {
  userId    String   @id
  requestId String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// 우회 루프 차단: 성적·제3자 사유로 차단된 이미지 해시 (이미지 자체는 저장하지 않는다)
model BlockedImage {
  hash      String   @id
  expiresAt DateTime

  @@index([expiresAt])
}
