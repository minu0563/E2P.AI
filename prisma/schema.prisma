// OpenNext(Cloudflare) 공식 방식: prisma-client-js + output 지정 없음 → OpenNext가 빌드 때 Workers용으로 패치한다
// (출력 경로를 지정하면 패치되지 않아 Workers에서 WebAssembly 실행 중 컴파일 오류가 난다)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  /// Google 계정 고유 ID (OIDC sub). 이메일이 바뀌어도 같은 사람
  googleSub  String?   @unique
  name       String?
  verifiedAt DateTime?
  /// 관리자가 정지한 시각 (있으면 로그인·생성 불가)
  suspendedAt   DateTime?
  suspendReason String?
  /// 연속 차단에 따른 생성 일시 제한 (이 시각까지 생성 불가, 로그인은 됨). lib/abuse.ts
  restrictedUntil DateTime?
  /// 탈퇴 시각 (행은 남기고 로그인·생성 불가. 보관 기간 뒤 정리 작업이 파기 — lib/retention.ts)
  withdrawnAt     DateTime?
  createdAt  DateTime  @default(now())
  sessions   Session[]
  consents   Consent[]
  credits    CreditEntry[]
  logs       GenerationLog[]
  inquiries  Inquiry[]

  @@index([withdrawnAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 약관 동의 시각·버전 기록
model Consent {
  id        String   @id @default(cuid())
  userId    String
  version   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

enum CreditKind {
  grant    // 지급 (+). grantId = 자기 자신
  reserve  // 요청 시작 시 예약 (-)
  release  // 실패·차단 시 예약 반환 (+)
  confirm  // 성공 확정 표시 (0)
  adjust   // 관리자 조정 (+/-)
}

enum CreditType {
  promo
  subscription
  topup
}

/// 크레딧 원장 (추가만 한다. 수정·삭제 금지 — 사람이 직접 검토할 코드).
/// 잔액 = 유효기간이 남은 지급분(grantId)별 amount 합.
model CreditEntry {
  id             String     @id
  userId         String
  kind           CreditKind
  creditType     CreditType
  amount         Int
  /// 어느 지급분에서 나가고 들어왔는지 (지급 항목은 자기 id)
  grantId        String
  requestId      String?
  /// 지급 항목만: 유효기간 (없으면 무기한)
  expiresAt      DateTime?
  /// 같은 이벤트가 두 번 처리되지 않게 (결제 웹훅 중복 등)
  idempotencyKey String?    @unique
  note           String?
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind])
  @@index([grantId])
  @@index([requestId])
}

/// 요청 로그 (텍스트·메타데이터만, 이미지 원본 저장 금지)
model GenerationLog {
  id          String   @id @default(cuid())
  requestId   String   @unique
  userId      String
  mode        String
  profile     String
  requestText String
  outcome     String
  blockCode   String?
  creditCost  Int
  /// 생성된 프롬프트 (성공한 경우). 다시 불러와 고칠 수 있게
  prompt      String?
  /// 당시 입력값: 모드, 항목별 값, 진행 속도, 길이, 비율, 빈칸 모드 (이미지는 저장하지 않음)
  input       Json?
  /// AI 사용량: 모델, 호출 수, 입력·출력 토큰, 추정 비용(백만분의 1 USD)
  model        String?
  aiCalls      Int?
  inputTokens  Int?
  outputTokens Int?
  costMicroUsd Int?
  /// AI 판정값 (관리자 전용, 사용자에게 보내지 않는다). 키워드만으로 막히면 이미지 칸은 비어 있다
  imageHash       String?
  imageType       String?
  personCount     Int?
  estimatedAge    Int?
  ageAssessment   String?
  minorCues       String[] @default([])
  sexualContent   String?
  requestLevel    String?
  thirdPartyClaim Boolean?
  /// 나머지 판정 정보: 이미지 설명(subject·scene), 걸린 키워드, 규칙 엔진 플래그, shadow 판정
  judgment        Json?
  /// 이미지 보관 (R2): 폴더(recent·blocked·quarantine·hold, null=저장 안 함), 저장 완료 시각, 만료 예정 시각
  imageTier      String?
  imageStoredAt  DateTime?
  imageExpiresAt DateTime?
  /// 관리자 오탐 표시 (프롬프트 보정·평가 세트용)
  falsePositive     Boolean   @default(false)
  falsePositiveNote String?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([ageAssessment, createdAt])
  @@index([imageHash])
  @@index([imageTier, createdAt])
}

/// 관리자 작업 기록 (누가 언제 무엇을). 추가만 한다
model AdminLog {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetUserId String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

/// 고정 창 속도 제한 카운터 (key = 대상:창번호). 만료된 줄은 정리 작업이 지운다
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// 진행 중인 생성 (사용자당 한 줄 → 동시 1건). 요청이 끝나면 지우고, 남으면 만료 후 다시 잡을 수 있다
model ActiveGeneration {
  userId    String   @id
  requestId String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// 우회 루프 차단: 성적·제3자 사유로 차단된 이미지 해시 (이미지 자체는 저장하지 않는다)
model BlockedImage {
  hash      String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// 하루(UTC) AI 사용량 합계. 예산 상한(config/ai.json budget) 판정에 쓴다
model AiUsage {
  day          String   @id /// "2026-11-17" (UTC, Cloudflare 무료 한도 초기화 기준과 같음)
  calls        Int      @default(0)
  generations  Int      @default(0)
  inputTokens  BigInt   @default(0)
  outputTokens BigInt   @default(0)
  costMicroUsd BigInt   @default(0)
  updatedAt    DateTime @updatedAt
}

/// 관리자 이미지 열람 세션 (Google 다시 로그인 뒤 발급). 열쇠는 그 탭에만 있고 여기엔 해시만 둔다
model ImageViewSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  adminEmail   String
  /// tuning(프롬프트 조정) | support(문의 대응) | other
  purpose      String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  /// manual | idle | max
  endReason    String?
  imagesLoaded Int       @default(0)

  @@index([adminEmail, createdAt])
}

/// 사용자 문의. 생성 건(requestId)에 연결하면 관리자가 그때 이미지·판정·프롬프트를 함께 본다
model Inquiry {
  id         String    @id @default(cuid())
  userId     String
  /// 연결된 생성 요청 (없으면 일반 문의)
  requestId  String?
  /// appeal(오차단 이의 제기) | quality(결과 품질) | other
  category   String
  body       String
  /// new | in_progress | done
  status     String    @default("new")
  adminNote  String?
  handledBy  String?
  handledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, requestId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}
